# NexaPy Framework Configuration Example
# Rename this file to framework.yaml to configure your application

app:
  name: NexaPy Starter Application

cors:
  enabled: true
  origins:
    - http://localhost:3000
    - http://localhost:5173

security:
  api_key: null                  # Or set NEXAPY_API_KEY env var
  hmac_secret: null              # Or set NEXAPY_HMAC_SECRET env var
  max_payload_bytes: 10485760    # 10MB default limit

ai:
  provider: auto                 # Options: auto, openai, gemini, anthropic, deepseek, freemodel
  strategy: priority             # Fallback strategy
  timeout: 30
  max_retries: 2
  rate_limit_requests: 120       # Per minute per IP
  priority:
    - openai
    - gemini
    - anthropic
    - deepseek
    - freemodel
  openai:
    model: gpt-4o-mini
  gemini:
    model: gemini-3.8-flash
  anthropic:
    model: claude-3-5-sonnet-20241022
  deepseek:
    model: deepseek-chat
  freemodel:
    model: auto

telemetry:
  storage: memory                # Options: memory, sqlite
  db_path: nexapy_telemetry.db
