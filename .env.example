# NexaPy Environment Variables Example
# Rename this file to .env for local development

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
FREEMODEL_API_KEY=your_freemodel_api_key_here

# NexaPy Framework Security & Settings
NEXAPY_API_KEY=your_secret_workflow_key_here
NEXAPY_HMAC_SECRET=your_hmac_webhook_secret_here
NEXAPY_APP_NAME="My NexaPy App"
NEXAPY_AI_PROVIDER=auto
NEXAPY_CORS_ENABLED=true
