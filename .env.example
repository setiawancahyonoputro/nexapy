# NexaPy Environment Variables Example
# Rename this file to .env for local development

# API Keys
FREEMODEL_API_KEY=your_freemodel_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# NexaPy Framework Settings
NEXAPY_APP_NAME="My NexaPy App"
NEXAPY_AI_PROVIDER=auto
NEXAPY_FREEMODEL_MODEL=auto
NEXAPY_GEMINI_MODEL=gemini-3.8-flash
NEXAPY_CORS_ENABLED=true
